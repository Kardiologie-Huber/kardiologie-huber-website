---
// Kopfbereich der Leistungsseiten ohne Hero-Foto: helles Band über die volle
// Breite mit Brotkrumen, H1, Einleitung und den wichtigsten Fakten vor dem Termin.
//
// Verwendung in MDX (ersetzt "# Titel" und den ersten Absatz):
//   <ServiceHeader
//     title="Stent-Kontrolle in Linz"
//     crumb="Stent-Kontrolle"
//     lead="Eine Stentimplantation dient dazu, …"
//     facts={[{ icon: 'clock', label: 'Dauer', value: 'etwa 45 Minuten' }, …]}
//     bring="Stentpass und Entlassungsbrief, Medikamentenliste, …"
//   />
interface Fact {
  icon: 'clock' | 'food' | 'pill' | 'file' | 'shirt';
  label: string;
  value: string;
}
const { title, crumb, lead, facts = [], bring } = Astro.props as {
  title: string;
  crumb?: string;
  lead?: string;
  facts?: Fact[];
  bring?: string;
};

const icons: Record<Fact['icon'], string> = {
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  food: '<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10"/><path d="M17 21V3c-2 1.5-3 4-3 7h3"/>',
  pill: '<rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  shirt: '<path d="M8 3l-5 3 2 5 3-1.5V21h8V9.5L19 11l2-5-5-3c-.5 1.5-2 2.5-4 2.5S8.5 4.5 8 3z"/>',
};
---

<div class="svc-head">
  <ol class="crumbs">
    <li><a href="/">Startseite</a></li>
    <li><a href="/leistungen/">Leistungen</a></li>
    <li aria-current="page">{crumb ?? title}</li>
  </ol>
  <h1 class="svc-h1">{title}</h1>
  {lead && <p class="svc-lead">{lead}</p>}

  {
    facts.length > 0 && (
      <dl class="svc-facts" aria-label="Vor Ihrem Termin">
        {facts.map((f) => (
          <div>
            <dt>
              <svg class="svc-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
              {f.label}
            </dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    bring && (
      <p class="svc-bring">
        <strong>Bitte mitbringen:</strong> {bring}
      </p>
    )
  }
</div>
