---
// Kopfbereich der Leistungsseiten ohne Hero-Foto:
//   1. dunkelblauer Kopf mit Brotkrumen, H1 und Einleitung, rechts "Auf dieser Seite"
//   2. dunkler Abschnitt "Vor Ihrem Termin" mit allen Hinweisen vor dem Besuch
//
// Verwendung in MDX (ersetzt "# Titel" und den ersten Absatz):
//   <ServiceHeader
//     title="Stent-Kontrolle in Linz"
//     crumb="Stent-Kontrolle"
//     lead="Eine Stentimplantation dient dazu, …"
//     prep={[
//       { icon: 'food', title: 'Nicht nüchtern', text: 'Sie können vorher normal essen und trinken.' },
//       …
//     ]}
//   />
import { getCollection } from 'astro:content';

type Icon = 'clock' | 'food' | 'pill' | 'file' | 'list' | 'shirt' | 'drop';
interface PrepItem {
  icon: Icon;
  title: string;
  text?: string;
}
const { title, crumb, lead, prep = [], prepTitle = 'Vor Ihrem Termin' } = Astro.props as {
  title: string;
  crumb?: string;
  lead?: string;
  prep?: PrepItem[];
  prepTitle?: string;
};

// "Auf dieser Seite": H2-Überschriften der aktuellen Seite (beim Build ermittelt)
const EXCLUDE = new Set(['Weitere Untersuchungen', 'Termin buchen']);
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');
const entry = (await getCollection('pages')).find((p) => p.slug === slug);
const headings = entry ? (await entry.render()).headings : [];
const toc = [
  ...(prep.length > 0 ? [{ slug: 'vor-ihrem-termin', text: prepTitle }] : []),
  ...headings.filter((h) => h.depth === 2 && !EXCLUDE.has(h.text)),
];

const icons: Record<Icon | 'alert', string> = {
  alert: '<path d="M12 3l9.5 16.5h-19z"/><path d="M12 10v4.5M12 17.5v.01"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  food: '<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10"/><path d="M17 21V3c-2 1.5-3 4-3 7h3"/>',
  pill: '<rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  list: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01"/>',
  shirt: '<path d="M8 3l-5 3 2 5 3-1.5V21h8V9.5L19 11l2-5-5-3c-.5 1.5-2 2.5-4 2.5S8.5 4.5 8 3z"/>',
  drop: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
};
---

<div class="svc-head">
  <div>
    <ol class="crumbs">
      <li><a href="/">Startseite</a></li>
      <li><a href="/leistungen/">Leistungen</a></li>
      <li aria-current="page">{crumb ?? title}</li>
    </ol>
    <h1 class="svc-h1">{title}</h1>
    {lead && <p class="svc-lead">{lead}</p>}
  </div>

  {
    toc.length > 1 && (
      <nav class="svc-toc" aria-label="Auf dieser Seite">
        <p>Auf dieser Seite</p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
</div>

{
  prep.length > 0 && (
    <section class="svc-prep" id="vor-ihrem-termin" aria-labelledby="svc-prep-title">
      <h2 id="svc-prep-title">
        <svg class="svc-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.alert} />
        {prepTitle}
      </h2>
      <ul>
        {prep.map((p) => (
          <li>
            <svg class="svc-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[p.icon]} />
            <span>
              <strong>{p.title}</strong>
              {p.text}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  prep.length > 0 && (
    <button class="svc-pill" type="button" data-svc-pill aria-hidden="true" tabindex="-1">
      <svg class="svc-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.alert} />
      {prepTitle}
    </button>
  )
}

{
  prep.length > 0 && (
    <script is:inline>
      // "Vor Ihrem Termin": einmaliger Vorhang beim ersten Sichtbarwerden und eine
      // mitlaufende Pille, sobald der Abschnitt nach oben aus dem Bild gescrollt ist.
      // Ohne JavaScript oder IntersectionObserver ist alles sofort sichtbar.
      (function () {
        const band = document.getElementById('vor-ihrem-termin');
        const pill = document.querySelector('[data-svc-pill]');
        if (!band || !pill || !('IntersectionObserver' in window)) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. Vorhang auf (nur in sichtbaren Tabs, sonst bleibt der Block einfach stehen)
        if (!document.hidden) {
          band.classList.add('is-armed');
          void band.offsetWidth;
          const reveal = () => band.classList.add('is-in');
          if (band.getBoundingClientRect().top < window.innerHeight * 0.85) {
            setTimeout(reveal, 250);
          } else {
            const io = new IntersectionObserver(
              (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                  reveal();
                  io.disconnect();
                }
              },
              { threshold: 0.25 }
            );
            io.observe(band);
            setTimeout(reveal, 4000); // Sicherheitsnetz: nie dauerhaft verborgen
          }
        }

        // 2. Mitlaufende Pille
        const show = (on) => {
          pill.classList.toggle('is-visible', on);
          pill.setAttribute('aria-hidden', on ? 'false' : 'true');
          pill.tabIndex = on ? 0 : -1;
        };
        new IntersectionObserver((entries) => {
          const e = entries[0];
          show(!e.isIntersecting && e.boundingClientRect.top < 0);
        }).observe(band);

        pill.addEventListener('click', () => {
          band.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          const title = band.querySelector('h2');
          title.setAttribute('tabindex', '-1');
          setTimeout(() => {
            title.focus({ preventScroll: true });
            band.classList.add('is-flash');
            setTimeout(() => band.classList.remove('is-flash'), 1200);
          }, reduce ? 0 : 450);
        });
      })();
    </script>
  )
}
