---
import { EMAIL, PHONE } from '../../constants';
const phoneHref = `tel:+43${PHONE.replace(/\s/g, '').replace(/^0/, '')}`;
---

<div class="container">
  <div class="footer-grid">
    <a class="footer-logo" href="/"><img src="/images/logo-white.svg" width="250" alt="Kardiologie Huber" /></a>
    <address class="footer-address">
      <strong>Kardiologie Huber</strong>
      Dr. med. Peter Huber<br />
      Facharzt für Innere Medizin und Kardiologie<br />
      Weißenwolffstraße 1, 4020 Linz
    </address>
    <div class="footer-contact">
      <a href={phoneHref}>{PHONE}</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <p>Ordinationszeiten nach Vereinbarung</p>
    </div>
    <nav class="footer-nav" aria-label="Fußzeile">
      <ul>
        <li><a href="/leistungen/">Leistungen</a></li>
        <li><a href="/wahlarzt/">Wahlarzt</a></li>
        <li><a href="/dr-peter-huber/">Über mich</a></li>
        <li><a href="/faqs/">FAQs</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
      <ul>
        <li><a href="/downloads/blutdruck-tagebuch/">Blutdruck-Tagebuch</a></li>
        <li><a href="/downloads/langzeit-ekg-tagebuch/">Langzeit-EKG-Tagebuch</a></li>
      </ul>
    </nav>
  </div>
  <div class="footer-meta">
    <span>&copy; {new Date().getFullYear()} Dr. med. Peter Huber</span>
    <a href="/impressum/">Impressum</a>
    <a href="/dsgvo/">DSGVO</a>
  </div>
</div>
