---
import { EMAIL, LATIDO } from '../../constants';

const { title, description, pageTitle } = Astro.props;

const SITE = 'https://kardiologie-huber.at';
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, SITE).toString();
const portrait = `${SITE}/images/dr-peter-huber-2.jpg`;
const ogImage = `${SITE}/images/og-image.png`;

// ---------- schema.org: Ordination ----------
const services = [
  { name: 'Herzultraschall (Echokardiographie)', path: '/leistungen/echokardiographie/' },
  { name: 'Belastungs-EKG (Ergometrie)', path: '/leistungen/ergometrie/' },
  { name: 'Ruhe-EKG', path: '/leistungen/ruhe-ekg/' },
  { name: 'Langzeit-EKG (Holter-EKG)', path: '/leistungen/langzeit-ekg/' },
  { name: '24-Stunden-Blutdruckmessung', path: '/leistungen/24-stunden-blutdruck/' },
  { name: 'Ultraschall der Halsschlagader (Carotis-Duplex)', path: '/leistungen/ultraschall-halsschlagader/' },
  { name: 'Ultraschall von Bauch und Nieren', path: '/leistungen/abdomen-nieren-sonographie/' },
  { name: 'Polygraphie (Schlafapnoe-Screening)', path: '/leistungen/polygraphie/' },
  { name: 'Kleine Spirometrie', path: '/leistungen/spirometrie/' },
  { name: 'Laborkontrolle (Blutuntersuchung)', path: '/leistungen/laborkontrolle-blutuntersuchung/' },
  { name: 'Anamnese & kardiologische Untersuchung', path: '/leistungen/anamnese-und-untersuchung/' },
  { name: 'Stent-Kontrolle', path: '/leistungen/stent-kontrolle/' },
  { name: 'Nachkontrolle nach Herzinfarkt', path: '/leistungen/nachkontrolle-nach-herzinfarkt/' },
  { name: 'Herzklappen-Nachsorge', path: '/leistungen/herzklappen-nachsorge/' },
  { name: 'Bluthochdruck-Behandlung', path: '/leistungen/bluthochdruck/' },
  { name: 'Diabetes-Betreuung', path: '/leistungen/diabetes-mellitus/' },
  { name: 'Fettstoffwechselstörungen (Cholesterin)', path: '/leistungen/fettstoffwechselstoerungen/' },
  { name: 'Herzrhythmusstörungen', path: '/leistungen/herzrhythmusstoerungen/' },
  { name: 'Herzschwäche (Herzinsuffizienz)', path: '/leistungen/herzschwaeche/' },
  { name: 'Herz-Kreislauf-Check (Vorsorge)', path: '/leistungen/herz-kreislauf-check/' },
  { name: 'OP-Freigabe', path: '/leistungen/op-freigabe/' },
];

const physician = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  '@id': `${SITE}/#identity`,
  name: 'Kardiologe Linz - Ordination Dr. Peter Huber',
  alternateName: 'Kardiologie Huber',
  url: `${SITE}/`,
  description:
    'Facharzt für Innere Medizin und Kardiologie in Linz. Wahlarztordination für Vorsorge, Diagnostik und Behandlung von Herz-Kreislauf-Erkrankungen.',
  medicalSpecialty: 'Cardiovascular',
  isAcceptingNewPatients: true,
  telephone: '+43 681 813 612 95',
  email: EMAIL,
  image: portrait,
  logo: `${SITE}/logo.svg`,
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  paymentAccepted: ['Cash', 'DebitCard', 'CreditCard'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Weißenwolffstraße 1',
    postalCode: '4020',
    addressLocality: 'Linz',
    addressRegion: 'Oberösterreich',
    addressCountry: 'AT',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 48.302882,
    longitude: 14.299991,
  },
  hasMap: 'https://maps.app.goo.gl/USqswJky77wg3Hms7',
  areaServed: [
    { '@type': 'City', name: 'Linz' },
    { '@type': 'AdministrativeArea', name: 'Oberösterreich' },
  ],
  knowsLanguage: ['de', 'en'],
  founder: {
    '@type': 'Person',
    '@id': `${SITE}/dr-peter-huber/#person`,
    name: 'Dr. med. Peter Huber',
    honorificPrefix: 'Dr. med.',
    jobTitle: 'Facharzt für Innere Medizin, Kardiologie und Intensivmedizin',
    url: `${SITE}/dr-peter-huber/`,
    image: portrait,
    worksFor: { '@id': `${SITE}/#identity` },
  },
  availableService: services.map((s) => ({
    '@type': 'MedicalProcedure',
    name: s.name,
    url: `${SITE}${s.path}`,
  })),
  potentialAction: {
    '@type': 'ReserveAction',
    name: 'Online Termin buchen',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: LATIDO,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
  },
  sameAs: [
    'https://maps.app.goo.gl/MRHuxkkUXDvoFzDJ7',
    'https://www.docfinder.at/internist/4020-linz/dr-peter-huber',
    'https://www.herold.at/gelbe-seiten/linz/jGS2Z/kardiologe-huber/',
    'https://arztsuche24.at/innere-medizin/4020-linz/kardiologe-huber-MjAyNjE4MA/',
  ],
};

// ---------- schema.org: Breadcrumbs (nicht auf der Startseite) ----------
const segments = pathname.split('/').filter(Boolean);
let breadcrumb: Record<string, unknown> | null = null;
if (segments.length > 0) {
  const items = [{ name: 'Startseite', url: `${SITE}/` }];
  if (segments[0] === 'leistungen' && segments.length > 1) {
    items.push({ name: 'Leistungen', url: `${SITE}/leistungen/` });
  }
  items.push({ name: pageTitle ?? title, url: canonicalURL });
  breadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: item.url,
    })),
  };
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Kardiologie Huber" />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Title and description -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Social -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Kardiologie Huber" />
<meta property="og:locale" content="de_AT" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="Kardiologe in Linz – Dr. Peter Huber, Facharzt für Innere Medizin und Kardiologie" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- schema.org -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(physician)} />
{
  breadcrumb && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  )
}
