---
import Head from '../components/page/Head.astro';
import { getImage } from 'astro:assets';
import Navbar from '../components/page/Navbar.astro';
import Footer from '../components/page/Footer.astro';
import { Image } from 'astro:assets';
import bootstrap from 'bootstrap/dist/js/bootstrap.bundle.min.js?url';
import '../styles/styles.scss';
import { LATIDO } from '../constants';

const {
  title,
  description,
  heroimage,
  herotitle,
  herosubtitle,
  herodescription,
  heroimageposition,
  herowash,
  herotextside,
} = Astro.props;

let heroStyle = '';
if (heroimage) {
  // Large hero: uncropped photo, subject placed per page via heroimageposition (desktop).
  // Small hero (no title): fixed 1920x500 strip.
  const optimizedBackground = herotitle
    ? await getImage({ src: heroimage, format: 'webp', width: Math.min(2400, heroimage.width) })
    : await getImage({ src: heroimage, format: 'webp', width: 1920, height: 500 });
  heroStyle = herotitle
    ? `background-image: url(${optimizedBackground.src}); --hero-pos: ${heroimageposition ?? '50% 30%'}; --hero-wash: ${herowash ?? 0.6}`
    : `background-image: url(${optimizedBackground.src}); background-position: ${heroimageposition ?? 'center top'}`;
}
---

<html lang="de">
  <head>
    <Head
      title={title ? title + ' | Kardiologie Huber' : 'Kardiologie Huber'}
      pageTitle={title}
      description={description}
    />
  </head>

  <body>
    <header>
      <Navbar />
    </header>

    <main>
      {
        heroimage && (
          herotitle ? (
            <div class={herotextside === 'right' ? 'hero hero-right' : 'hero'}>
              <div class="hero-photo" style={heroStyle} aria-hidden="true" />
              <div class="container hero-inner">
                <div class="hero-copy">
                  <h1>
                    {herotitle}
                    <br />
                    {herosubtitle && <span class="hero-subtitle">{herosubtitle}</span>}
                  </h1>
                  {herodescription && (
                    <div class="hero-description">
                      <p set:html={herodescription} />
                    </div>
                  )}
                </div>
              </div>
            </div>
          ) : (
            <div class="hero-image" style={heroStyle} />
          )
        )
      }
      <div class="container">
        <div class="row">
          <div class="col-12">
            <slot />
          </div>
        </div>
      </div>
    </main>

    <footer>
      <Footer />
    </footer>

    <!-- 100% privacy-first analytics -->
    <script
      data-collect-dnt="true"
      async
      src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <script
      data-collect-dnt="true"
      async
      src="https://scripts.simpleanalyticscdn.com/auto-events.js"></script>
  </body><script src={bootstrap}></script>
  <script
    src="https://kit.fontawesome.com/9fc80d8fb2.js"
    crossorigin="anonymous"></script>
</html>
